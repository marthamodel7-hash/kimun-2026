{
  "version": 2,
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "api/index.py",
      "installCommand": "pip install -r api/requirements.txt",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "installCommand": "npm install",
      "buildCommand": "npm run vercel-build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
