{
  "version": 2,
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "api/index.py"
    },
    "frontend": {
      "root": "frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
