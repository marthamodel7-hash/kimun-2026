# Copy to .env — never commit real keys. Keys are server-side only.
DATABASE_URL=sqlite:///./kimun.db
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# AI provider: "gemini" (Google) or "nvidia" (NVIDIA Integrate). Server-side only.
AI_PROVIDER=gemini
# Google Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
# NVIDIA fallback (server-side only)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024
CONFERENCE_NAME=KIMUN 2026
CONFERENCE_VENUE=Karachi
CONFERENCE_DATE=2026-12-18
# SMTP email (falls back to console log when SMTP_HOST is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kimun.org
